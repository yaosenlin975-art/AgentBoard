{
  "name": "agentboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node scripts/check-bom.mjs && node scripts/run-lint.mjs",
    "lint": "node scripts/run-lint.mjs",
    "lint:update-baseline": "node scripts/run-lint.mjs --update-baseline",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "server:ensure": "node scripts/server-detached.mjs",
    "check:stale": "node scripts/check-stale.mjs",
    "dev:test-page": "node scripts/dev-page.mjs",
    "publish:web": "node scripts/rebuild-web-dist.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "shortcut:test-page": "powershell -ExecutionPolicy Bypass -File scripts/create-test-page-shortcut.ps1"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
